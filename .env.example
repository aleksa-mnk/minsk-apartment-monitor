# Get the token with /newbot in https://t.me/BotFather
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN
# Optional: to lock the bot to your Telegram ID (recommended).
# If blank, the first person to send /start becomes owner.
ALLOWED_USER_ID=
# Time between monitoring scans, minimum allowed 300 seconds.
CHECK_INTERVAL_SECONDS=600
# 1-5 pages per provider; more pages mean more requests and more coverage.
PAGES_PER_SOURCE=3
DB_PATH=data/apartments.sqlite3

# Only for scheduled_check.py on GitHub/local tests (do not commit .env).
TELEGRAM_CHAT_ID=
